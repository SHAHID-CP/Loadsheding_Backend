model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  action    AuditAction
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}