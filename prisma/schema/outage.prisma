model Outage {
  id              String       @id @default(uuid())
  type            OutageType
  status          OutageStatus @default(REPORTED)
  startAt         DateTime     @default(now())
  endAt           DateTime?
  cause           String?
  affectedCount   Int          @default(0)
  areaId          String
  scheduleId      String?
  primaryReportId String?      @unique
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  area          Area              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  schedule      LoadShedSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  primaryReport OutageReport?     @relation("OutagePrimaryReport", fields: [primaryReportId], references: [id], onDelete: SetNull)
  reports       OutageReport[]    @relation("OutageReports")
  assignments   Assignment[]

  @@index([areaId, status])
  @@index([type, status])
  @@index([startAt])
  @@index([deletedAt])
  @@map("outages")
}